<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Control de Tránsitos y Recibo Logístico - SAP / Power Apps</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js para Gráficas -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- SheetJS para leer archivos Excel (.xlsx) -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        body { font-family: 'Inter', sans-serif; }
        .tab-active {
            background-color: #1e3a8a;
            color: #ffffff;
            box-shadow: 0 4px 6px -1px rgba(30, 58, 138, 0.25);
        }
        /* Scrollbar sutil */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

        /* Estilos exclusivos para impresión limpia de la Carátula de Consolidado */
        @media print {
            body * { visibility: hidden !important; }
            #caratula-printable-area, #caratula-printable-area * { visibility: visible !important; }
            #caratula-printable-area {
                position: fixed !important;
                left: 0 !important;
                top: 0 !important;
                width: 100% !important;
                margin: 0 !important;
                padding: 12px !important;
                box-shadow: none !important;
                border: none !important;
                background: white !important;
            }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen flex flex-col">

    <!-- Contenedor de Notificaciones Toast -->
    <div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none"></div>

    <!-- Barra Superior Corporativa -->
    <header class="bg-slate-900 text-white shadow-lg sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-wrap items-center justify-between py-3 gap-3">
                <!-- Logo / Título -->
                <div class="flex items-center gap-3">
                    <div class="bg-blue-600 p-2 rounded-xl shadow-inner">
                        <i data-lucide="truck" class="w-6 h-6 text-white"></i>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <h1 class="text-lg font-bold tracking-tight">Logística | Control de Tránsitos SAP</h1>
                            <span class="hidden sm:inline-block text-[11px] font-semibold uppercase tracking-wider bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 px-2 py-0.5 rounded-full">Power Pages + Dataverse</span>
                        </div>
                        <p class="text-xs text-slate-400">Usuario Activo: <strong id="header-user-display" class="text-blue-300">Operador Logístico</strong></p>
                    </div>
                </div>

                <!-- Controles Super Usuario / Base Excel -->
                <div class="flex items-center gap-2 flex-wrap">
                    <button onclick="openExcelModal()" class="flex items-center gap-2 bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 px-3 py-2 rounded-xl text-xs font-medium transition cursor-pointer">
                        <i data-lucide="file-spreadsheet" class="w-4 h-4 text-emerald-400"></i>
                        <span>Base SAP (<span id="header-sap-count">83</span> filas)</span>
                    </button>
                    <button onclick="openConfirmReset()" class="flex items-center gap-1.5 bg-slate-800 hover:bg-rose-950 text-slate-300 hover:text-rose-200 border border-slate-700 px-3 py-2 rounded-xl text-xs font-medium transition cursor-pointer" title="Reiniciar datos de prueba">
                        <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i>
                        <span class="hidden md:inline">Reiniciar Demo</span>
                    </button>
                </div>
            </div>

            <!-- Menú Principal de Navegación -->
            <nav class="flex space-x-2 pb-3 overflow-x-auto" aria-label="Menú Principal">
                <button id="nav-retorno" onclick="switchTab('retorno')" class="tab-active flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold transition whitespace-nowrap cursor-pointer">
                    <i data-lucide="clipboard-check" class="w-4 h-4"></i>
                    <span>1. Retorno (Recibo Físico)</span>
                    <span id="badge-recibidos" class="ml-1 bg-white/20 text-white text-xs px-2 py-0.5 rounded-full">0</span>
                </button>
                <button id="nav-consolidados" onclick="switchTab('consolidados')" class="bg-slate-800/70 text-slate-300 hover:bg-slate-800 hover:text-white flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold transition whitespace-nowrap cursor-pointer">
                    <i data-lucide="boxes" class="w-4 h-4"></i>
                    <span>2. Consolidados</span>
                    <span id="badge-consolidados" class="ml-1 bg-slate-700 text-slate-200 text-xs px-2 py-0.5 rounded-full">0</span>
                </button>
                <button id="nav-confirmacion" onclick="switchTab('confirmacion')" class="bg-slate-800/70 text-slate-300 hover:bg-slate-800 hover:text-white flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold transition whitespace-nowrap cursor-pointer">
                    <i data-lucide="check-circle-2" class="w-4 h-4"></i>
                    <span>3. Confirmación</span>
                </button>
                <button id="nav-graficas" onclick="switchTab('graficas')" class="bg-slate-800/70 text-slate-300 hover:bg-slate-800 hover:text-white flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold transition whitespace-nowrap cursor-pointer">
                    <i data-lucide="bar-chart-3" class="w-4 h-4"></i>
                    <span>4. Gráficas y KPIs</span>
                </button>
            </nav>
        </div>
    </header>

    <!-- Contenido Principal -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

        <!-- ===================================================================== -->
        <!-- MÓDULO 1: RETORNO (RECIBO FÍSICO Y COMPARACIÓN CONTRA SAP)             -->
        <!-- ===================================================================== -->
        <section id="view-retorno" class="space-y-6">
            <!-- Tarjeta Principal de Captura -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="bg-gradient-to-r from-blue-900 to-slate-800 px-6 py-4 flex flex-wrap items-center justify-between gap-2">
                    <div class="flex items-center gap-2.5 text-white">
                        <i data-lucide="scan-line" class="w-5 h-5 text-blue-300"></i>
                        <h2 class="font-bold text-base sm:text-lg">Registro de Recibo Físico (Validación vs. SAP)</h2>
                    </div>
                    <div class="flex items-center gap-2 text-xs text-blue-200 bg-white/10 px-3 py-1.5 rounded-lg">
                        <i data-lucide="calendar-clock" class="w-4 h-4"></i>
                        <span>Fecha/Hora Recibo Automática: <strong id="live-clock" class="text-white"></strong></span>
                    </div>
                </div>

                <div class="p-6 space-y-6">
                    <!-- Línea Manual de Búsqueda de Entrega -->
                    <div class="bg-blue-50/70 border border-blue-200 rounded-xl p-4">
                        <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
                            <div class="md:col-span-5">
                                <label for="input-entrega" class="block text-xs font-bold uppercase tracking-wider text-blue-900 mb-1.5">
                                    1. Ingresa Número de Entrega (SAP) *
                                </label>
                                <div class="relative flex items-center">
                                    <input type="text" id="input-entrega" oninput="buscarEntregaSAP(this.value)" placeholder="Ej. 818369293 o 819248245..." 
                                        class="w-full pl-4 pr-10 py-3 bg-white border-2 border-blue-400 focus:border-blue-600 focus:ring-4 focus:ring-blue-500/10 rounded-xl text-base font-bold text-slate-900 outline-none transition" />
                                    <button onclick="limpiarFormularioRetorno()" title="Limpiar búsqueda" class="absolute right-3 text-slate-400 hover:text-slate-600 cursor-pointer">
                                        <i data-lucide="x-circle" class="w-5 h-5"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Selector rápido de entregas disponibles en el Excel -->
                            <div class="md:col-span-5">
                                <label for="select-entrega-demo" class="block text-xs font-semibold text-slate-600 mb-1.5">
                                    O selecciona una entrega pendiente del Excel ZMM0014:
                                </label>
                                <select id="select-entrega-demo" onchange="seleccionarEntregaCombo(this.value)" class="w-full py-3 px-3 bg-white border border-slate-300 rounded-xl text-sm text-slate-700 focus:border-blue-500 outline-none">
                                    <option value="">-- Seleccionar entrega en tránsito --</option>
                                </select>
                            </div>

                            <div class="md:col-span-2">
                                <button onclick="openExcelModal()" class="w-full py-3 px-3 bg-white hover:bg-slate-50 border border-slate-300 text-slate-700 rounded-xl text-xs font-semibold flex items-center justify-center gap-1.5 transition cursor-pointer">
                                    <i data-lucide="list-filter" class="w-4 h-4 text-blue-600"></i>
                                    <span>Ver Todas</span>
                                </button>
                            </div>
                        </div>
                        <div id="entrega-status-msg" class="mt-2 text-xs font-medium text-slate-500">
                            Escribe o selecciona un número de entrega para cargar automáticamente los datos de SAP.
                        </div>
                    </div>

                    <!-- Panel Dinámico que aparece al encontrar una Entrega -->
                    <div id="panel-detalle-entrega" class="space-y-6 opacity-50 pointer-events-none transition-all duration-200">
                        
                        <!-- Datos Automáticos extraídos de SAP -->
                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center gap-1.5">
                                    <i data-lucide="database" class="w-3.5 h-3.5"></i>
                                    Datos Automáticos desde Base SAP
                                </h3>
                                <span id="badge-filas-entrega" class="text-xs font-bold bg-blue-100 text-blue-800 px-2.5 py-0.5 rounded-full">0 líneas en entrega</span>
                            </div>
                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                                <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200">
                                    <span class="block text-[11px] font-semibold text-slate-500 uppercase">Localidad Origen</span>
                                    <span id="sap-origen" class="text-sm font-bold text-slate-800 mt-0.5 block">-</span>
                                </div>
                                <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200">
                                    <span class="block text-[11px] font-semibold text-slate-500 uppercase">Localidad Destino (Col. C)</span>
                                    <span id="sap-destino" class="text-sm font-bold text-slate-800 mt-0.5 block">-</span>
                                </div>
                                <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200">
                                    <div class="flex items-center justify-between">
                                        <span class="block text-[11px] font-semibold text-slate-500 uppercase">Carta porte/viaje</span>
                                        <span class="text-[10px] font-bold bg-blue-100 text-blue-800 px-1.5 py-0.2 rounded">Editable</span>
                                    </div>
                                    <input type="text" id="sap-carta-porte" placeholder="Captura o corrige Carta porte/viaje..."
                                        class="w-full mt-1 py-1.5 px-2.5 bg-white border border-slate-300 focus:border-blue-600 rounded-lg text-sm font-bold text-slate-900 outline-none transition" />
                                </div>
                                <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200">
                                    <div class="flex items-center justify-between">
                                        <span class="block text-[11px] font-semibold text-slate-500 uppercase">Unidad Registrada</span>
                                        <span class="text-[10px] font-bold bg-blue-100 text-blue-800 px-1.5 py-0.2 rounded">Editable</span>
                                    </div>
                                    <input type="text" id="sap-unidad" placeholder="Captura o corrige Unidad..."
                                        class="w-full mt-1 py-1.5 px-2.5 bg-white border border-slate-300 focus:border-blue-600 rounded-lg text-sm font-bold text-slate-900 outline-none transition" />
                                </div>
                            </div>
                        </div>

                        <!-- Validación Física Multi-Fila / Multi-Material -->
                        <div class="border-t border-b border-slate-200 py-5 space-y-4">
                            <div class="flex flex-wrap items-center justify-between gap-2">
                                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 flex items-center gap-1.5">
                                    <i data-lucide="package-check" class="w-4 h-4 text-blue-600"></i>
                                    Validación Física de Material Logístico
                                </h3>
                                <button type="button" onclick="agregarFilaMaterialExtra()" class="inline-flex items-center gap-1.5 bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200 px-3 py-1.5 rounded-xl text-xs font-bold transition cursor-pointer">
                                    <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                                    <span>Agregar Fila de Material Extra</span>
                                </button>
                            </div>

                            <!-- Tabla dinámica de materiales -->
                            <div class="border border-slate-200 rounded-2xl overflow-hidden bg-white shadow-2xs">
                                <div class="overflow-x-auto">
                                    <table class="w-full text-left border-collapse">
                                        <thead>
                                            <tr class="bg-slate-100 text-slate-600 text-[11px] uppercase tracking-wider border-b border-slate-200">
                                                <th class="py-3 px-3 font-bold">#</th>
                                                <th class="py-3 px-3 font-bold">Material y Descripción (Col. L+M)</th>
                                                <th class="py-3 px-3 font-bold text-center bg-blue-900 text-white">En Tránsito (Col. N)</th>
                                                <th class="py-3 px-3 font-bold text-center text-amber-800 bg-amber-50/70 w-24">Dañado</th>
                                                <th class="py-3 px-3 font-bold text-center text-rose-800 bg-rose-50/70 w-24">Scrap</th>
                                                <th class="py-3 px-3 font-bold text-center text-slate-800 bg-slate-200/50 w-24">Faltante</th>
                                                <th class="py-3 px-3 font-bold text-center text-emerald-800 bg-emerald-50/70">Buenas</th>
                                                <th class="py-3 px-3 font-bold">Resultado en Tiempo Real</th>
                                            </tr>
                                        </thead>
                                        <tbody id="tbody-materiales-entrega" class="divide-y divide-slate-200 text-sm">
                                            <!-- Dinámico -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Mensaje Dinámico de Cálculo Total -->
                            <div id="resumen-calculo-box" class="bg-emerald-50 border border-emerald-200 rounded-xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                                <div class="flex items-start sm:items-center gap-3">
                                    <div class="bg-emerald-600 text-white p-2 rounded-lg shrink-0">
                                        <i data-lucide="calculator" class="w-5 h-5"></i>
                                    </div>
                                    <p id="texto-calculo-dinamico" class="text-sm sm:text-base font-medium text-emerald-950">
                                        De <strong>0</strong> unidades en tránsito: <strong>0</strong> son buenas y <strong>0</strong> con incidencia.
                                    </p>
                                </div>
                                <div class="flex items-center gap-2 shrink-0">
                                    <span class="text-xs font-semibold uppercase text-emerald-700">Total Buenas:</span>
                                    <span id="badge-buenas" class="text-lg font-extrabold bg-emerald-600 text-white px-3 py-1 rounded-lg">0</span>
                                </div>
                            </div>
                        </div>

                        <!-- Comentarios + Fecha Automática -->
                        <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
                            <div class="md:col-span-8">
                                <label for="input-comentarios" class="block text-xs font-bold text-slate-700 mb-1.5">Comentarios de Recibo</label>
                                <input type="text" id="input-comentarios" placeholder="Observaciones de descarga, estado de unidad, etc." 
                                    class="w-full py-2.5 px-3.5 bg-white border border-slate-300 focus:border-blue-500 rounded-xl text-sm text-slate-800 outline-none" />
                            </div>

                            <div class="md:col-span-4">
                                <label class="block text-xs font-bold text-slate-700 mb-1.5">Fecha de Recibo (Auto)</label>
                                <input type="text" id="input-fecha-recibo" readonly 
                                    class="w-full py-2.5 px-3.5 bg-slate-100 border border-slate-200 rounded-xl text-sm font-semibold text-slate-600 cursor-not-allowed" />
                            </div>
                        </div>

                        <!-- Botón Enviar -->
                        <div class="flex justify-end pt-2">
                            <button id="btn-guardar-retorno" onclick="guardarRetorno()" class="w-full sm:w-auto flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-700 active:scale-[0.99] text-white font-bold px-8 py-3.5 rounded-xl shadow-md shadow-emerald-600/20 transition cursor-pointer">
                                <i data-lucide="send" class="w-4 h-4"></i>
                                <span>Enviar y Guardar Recibo</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tabla de Retornos Registrados -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="px-6 py-4 border-b border-slate-200 flex flex-wrap items-center justify-between gap-3 bg-slate-50">
                    <div>
                        <h3 class="font-bold text-slate-800 text-base">Historial de Retornos Recibidos Físicamente</h3>
                        <p class="text-xs text-slate-500">Registros validados por línea/material listos para consolidación</p>
                    </div>
                    <div class="flex items-center gap-2.5 flex-wrap">
                        <span id="contador-tabla-retornos" class="text-xs font-bold bg-blue-100 text-blue-800 px-3 py-1.5 rounded-full">0 registros</span>
                        <button onclick="exportarRetornosExcel()" class="inline-flex items-center gap-2 bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-bold px-4 py-2.5 rounded-xl shadow-sm transition cursor-pointer">
                            <i data-lucide="file-spreadsheet" class="w-4 h-4"></i>
                            <span>Guardar Retorno en Excel</span>
                        </button>
                    </div>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-100/80 text-slate-600 text-[11px] uppercase tracking-wider border-b border-slate-200">
                                <th class="py-3 px-4 font-bold">Entrega</th>
                                <th class="py-3 px-4 font-bold">Material</th>
                                <th class="py-3 px-4 font-bold">Origen</th>
                                <th class="py-3 px-4 font-bold">Carta Porte / Viaje</th>
                                <th class="py-3 px-4 font-bold">Unidad (Col. T)</th>
                                <th class="py-3 px-4 font-bold text-center">Tránsito</th>
                                <th class="py-3 px-4 font-bold text-center text-emerald-700">Buenas</th>
                                <th class="py-3 px-4 font-bold text-center text-amber-700">Dañado</th>
                                <th class="py-3 px-4 font-bold text-center text-rose-700">Scrap</th>
                                <th class="py-3 px-4 font-bold text-center text-slate-700">Faltante</th>
                                <th class="py-3 px-4 font-bold">Fecha Recibo</th>
                                <th class="py-3 px-4 font-bold">Comentarios</th>
                                <th class="py-3 px-4 font-bold text-center">Estatus</th>
                            </tr>
                        </thead>
                        <tbody id="tbody-retornos" class="divide-y divide-slate-100 text-sm">
                            <!-- Dinámico -->
                        </tbody>
                    </table>
                </div>
            </div>
        </section>


        <!-- ===================================================================== -->
        <!-- MÓDULO 2: CONSOLIDADOS                                                -->
        <!-- ===================================================================== -->
        <section id="view-consolidados" class="hidden space-y-6">
            
            <!-- Sub-navegación interna de Consolidados -->
            <div class="bg-white p-2 rounded-2xl shadow-sm border border-slate-200 inline-flex gap-2">
                <button id="subtab-armar" onclick="switchSubConsolidado('armar')" class="px-4 py-2 rounded-xl text-sm font-bold bg-blue-900 text-white transition cursor-pointer flex items-center gap-2">
                    <i data-lucide="package-plus" class="w-4 h-4"></i>
                    <span>1. Consolidar Retornos</span>
                </button>
                <button id="subtab-envios" onclick="switchSubConsolidado('envios')" class="px-4 py-2 rounded-xl text-sm font-bold text-slate-600 hover:bg-slate-100 transition cursor-pointer flex items-center gap-2">
                    <i data-lucide="truck" class="w-4 h-4"></i>
                    <span>2. Envíos Consolidados</span>
                    <span id="badge-sub-envios" class="bg-slate-200 text-slate-700 text-xs px-2 py-0.5 rounded-full">0</span>
                </button>
            </div>

            <!-- SUB-VISTA A: ARMAR CONSOLIDADO -->
            <div id="panel-armar-consolidado" class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                <!-- Columna Izquierda: Agregar Entregas ya recibidas en Retorno -->
                <div class="lg:col-span-7 bg-white rounded-2xl shadow-sm border border-slate-200 p-6 space-y-5">
                    <div class="border-b border-slate-100 pb-3">
                        <h2 class="text-lg font-bold text-slate-800">Consolidar Entregas Recibidas</h2>
                        <p class="text-xs text-slate-500">Ingresa manualmente las entregas previamente registradas en <strong>Retorno</strong> (solo ítem <strong>1200000090-TARIMA CHEP</strong>).</p>
                    </div>

                    <!-- Buscador / Agregador Manual -->
                    <div class="flex flex-col sm:flex-row gap-2">
                        <input type="text" id="input-entrega-consolidar" placeholder="Escribe N° de Entrega recibida en Retorno..." 
                            class="flex-1 py-3 px-4 bg-slate-50 border border-slate-300 focus:border-blue-600 focus:bg-white rounded-xl text-sm font-bold outline-none" 
                            onkeypress="if(event.key==='Enter') agregarEntregaAConsolidado()" />
                        <button onclick="agregarEntregaAConsolidado()" class="bg-blue-700 hover:bg-blue-800 text-white font-semibold px-5 py-3 rounded-xl text-sm flex items-center justify-center gap-2 transition cursor-pointer">
                            <i data-lucide="plus-circle" class="w-4 h-4"></i>
                            <span>Agregar Entrega</span>
                        </button>
                    </div>

                    <!-- Lista rápida de Retornos Disponibles -->
                    <div>
                        <span class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Retornos disponibles para consolidar (1200000090-TARIMA CHEP — clic para agregar):</span>
                        <div id="lista-retornos-disponibles" class="flex flex-wrap gap-2 max-h-40 overflow-y-auto p-3 bg-slate-50 rounded-xl border border-slate-200">
                            <!-- Chips dinámicos -->
                        </div>
                    </div>

                    <!-- Tabla de Entregas agregadas al Lote actual -->
                    <div>
                        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Entregas seleccionadas en este consolidado:</h3>
