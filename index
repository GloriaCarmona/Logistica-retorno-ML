                        </td>
                        <td class="py-3 px-3 text-xs">
                            <div id="fila-texto-${index}" class="${excedido ? 'text-rose-700 font-bold' : 'text-slate-700'}">
                                ${excedido 
                                    ? `⚠️ Incidencias (${incidencias}) > Tránsito (${linea.transito})` 
                                    : `De <strong>${linea.transito}</strong>: <strong>${buenas}</strong> buenas, <strong>${linea.danado}</strong> dañ., <strong>${linea.scrap}</strong> scrap, <strong>${linea.faltante}</strong> falt.`}
                            </div>
                            ${linea.esExtra ? `
                                <button type="button" onclick="eliminarFilaMaterialExtra(${index})" class="mt-1 text-[11px] text-rose-600 hover:underline font-semibold cursor-pointer">Quitar fila extra</button>
                            ` : ''}
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function actualizarCantidadLinea(index, campo, valor) {
            if (!entregaSeleccionadaActual || !entregaSeleccionadaActual.lineas[index]) return;
            const num = Math.max(0, parseInt(valor) || 0);
            entregaSeleccionadaActual.lineas[index][campo] = num;

            const linea = entregaSeleccionadaActual.lineas[index];
            const incidencias = linea.danado + linea.scrap + linea.faltante;
            const excedido = incidencias > linea.transito;
            const buenas = Math.max(0, linea.transito - incidencias);

            const badgeEl = document.getElementById(`fila-buenas-${index}`);
            const textoEl = document.getElementById(`fila-texto-${index}`);
            if (badgeEl) {
                badgeEl.textContent = excedido ? 'ERR' : buenas;
                badgeEl.className = `inline-block min-w-[44px] py-1 px-2.5 rounded-lg font-extrabold text-sm ${excedido ? 'bg-rose-600 text-white' : 'bg-emerald-600 text-white'}`;
            }
            if (textoEl) {
                textoEl.className = excedido ? 'text-rose-700 font-bold' : 'text-slate-700';
                textoEl.innerHTML = excedido
                    ? `⚠️ Incidencias (${incidencias}) > Tránsito (${linea.transito})`
                    : `De <strong>${linea.transito}</strong>: <strong>${buenas}</strong> buenas, <strong>${linea.danado}</strong> dañ., <strong>${linea.scrap}</strong> scrap, <strong>${linea.faltante}</strong> falt.`;
            }

            recalcularTarimas();
        }

        function actualizarCampoExtra(index, campo, valor) {
            if (!entregaSeleccionadaActual || !entregaSeleccionadaActual.lineas[index]) return;
            if (campo === 'transito') {
                entregaSeleccionadaActual.lineas[index].transito = Math.max(0, parseInt(valor) || 0);
                actualizarCantidadLinea(index, 'danado', entregaSeleccionadaActual.lineas[index].danado);
            } else {
                entregaSeleccionadaActual.lineas[index][campo] = valor;
            }
        }

        function agregarFilaMaterialExtra() {
            if (!entregaSeleccionadaActual) return;
            entregaSeleccionadaActual.lineas.push({
                rowId: `extra_${Date.now()}`,
                material: "EXTRA-01",
                descMaterial: "MATERIAL ADICIONAL EN FÍSICO",
                um: "PZA",
                transito: 0,
                danado: 0,
                scrap: 0,
                faltante: 0,
                esExtra: true
            });
            document.getElementById('badge-filas-entrega').textContent = `${entregaSeleccionadaActual.lineas.length} línea(s) en entrega`;
            renderTablaMaterialesEntrega();
            recalcularTarimas();
        }

        function eliminarFilaMaterialExtra(index) {
            if (!entregaSeleccionadaActual) return;
            entregaSeleccionadaActual.lineas.splice(index, 1);
            document.getElementById('badge-filas-entrega').textContent = `${entregaSeleccionadaActual.lineas.length} línea(s) en entrega`;
            renderTablaMaterialesEntrega();
            recalcularTarimas();
        }

        function recalcularTarimas() {
            if (!entregaSeleccionadaActual) return;

            let totalTransito = 0;
            let totalDanado = 0;
            let totalScrap = 0;
            let totalFaltante = 0;
            let hayErrorFila = false;

            entregaSeleccionadaActual.lineas.forEach(l => {
                totalTransito += l.transito;
                totalDanado += l.danado;
                totalScrap += l.scrap;
                totalFaltante += l.faltante;
                if ((l.danado + l.scrap + l.faltante) > l.transito) {
                    hayErrorFila = true;
                }
            });

            const totalIncidencias = totalDanado + totalScrap + totalFaltante;
            const box = document.getElementById('resumen-calculo-box');
            const texto = document.getElementById('texto-calculo-dinamico');
            const badgeBuenas = document.getElementById('badge-buenas');
            const btnGuardar = document.getElementById('btn-guardar-retorno');

            if (hayErrorFila || totalIncidencias > totalTransito) {
                box.className = "bg-rose-50 border border-rose-300 rounded-xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3";
                texto.className = "text-sm font-semibold text-rose-800";
                texto.innerHTML = `⚠️ Error en una o más filas: La suma de Dañado + Scrap + Faltante no puede superar el Tránsito de cada material.`;
                badgeBuenas.textContent = "0";
                badgeBuenas.className = "text-lg font-extrabold bg-rose-600 text-white px-3 py-1 rounded-lg";
                btnGuardar.disabled = true;
                btnGuardar.classList.add('opacity-50', 'cursor-not-allowed');
                return;
            }

            btnGuardar.disabled = false;
            btnGuardar.classList.remove('opacity-50', 'cursor-not-allowed');

            const buenas = totalTransito - totalIncidencias;
            const descargadasFisicamente = totalTransito - totalFaltante;

            box.className = "bg-emerald-50 border border-emerald-200 rounded-xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3";
            texto.className = "text-sm sm:text-base font-medium text-emerald-950";

            let partesIncidencia = [];
            if (totalDanado > 0) partesIncidencia.push(`<strong>${totalDanado}</strong> dañadas`);
            if (totalScrap > 0) partesIncidencia.push(`<strong>${totalScrap}</strong> scrap`);
            if (totalFaltante > 0) partesIncidencia.push(`<strong>${totalFaltante}</strong> faltantes`);

            const detalleExtra = partesIncidencia.length > 0 ? `, ${partesIncidencia.join(', ')}` : ` (sin incidencias)`;
            texto.innerHTML = `De <strong>${totalTransito}</strong> unidades en tránsito (${descargadasFisicamente} descargadas): <strong>${buenas}</strong> son buenas${detalleExtra}.`;
            badgeBuenas.textContent = buenas;
            badgeBuenas.className = "text-lg font-extrabold bg-emerald-600 text-white px-3 py-1 rounded-lg";
        }

        async function guardarRetorno() {
            if (!entregaSeleccionadaActual) return;

            for (const l of entregaSeleccionadaActual.lineas) {
                if ((l.danado + l.scrap + l.faltante) > l.transito) {
                    showToast(`Error en material ${l.material}: las incidencias superan el tránsito.`, 'error');
                    return;
                }
            }

            const cartaPorteFinal = document.getElementById('sap-carta-porte').value.trim();
            const unidadFinal = document.getElementById('sap-unidad').value.trim();
            const comentarios = document.getElementById('input-comentarios').value.trim();
            const fechaRecibo = document.getElementById('input-fecha-recibo').value;

            let totalBuenasEntrega = 0;

            entregaSeleccionadaActual.lineas.forEach((l, idx) => {
                const buenas = l.transito - (l.danado + l.scrap + l.faltante);
                totalBuenasEntrega += buenas;

                const nuevoRegistro = {
                    id: `${Date.now()}_${idx}`,
                    entrega: entregaSeleccionadaActual.entrega,
                    material: l.material || 'SIN-MAT',
                    descMaterial: l.descMaterial || 'MATERIAL LOGÍSTICO',
                    um: l.um || 'PZA',
                    origen: entregaSeleccionadaActual.origen,
                    destino: entregaSeleccionadaActual.destino,
                    fechaContabilizacion: entregaSeleccionadaActual.fechaContabilizacion,
                    unidad: unidadFinal || '-',
                    cartaPorte: cartaPorteFinal || 'SIN CARTA PORTE',
                    transito: l.transito,
                    buenas,
                    danado: l.danado,
                    scrap: l.scrap,
                    faltante: l.faltante,
                    comentarios: comentarios || '-',
                    fechaRecibo,
                    usuarioReg: "Operador",
                    consolidadoId: null
                };
                retornosRecibidos.unshift(nuevoRegistro);
            });

            const entregaNum = entregaSeleccionadaActual.entrega;
            await saveState();
            poblarSelectorEntregas();
            renderTablaRetornos();
            limpiarFormularioRetorno();

            showToast(`Recibo de entrega ${entregaNum} guardado (${totalBuenasEntrega} buenas en total).`, 'success');
        }

        function limpiarFormularioRetorno() {
            document.getElementById('input-entrega').value = '';
            document.getElementById('select-entrega-demo').value = '';
            buscarEntregaSAP('');
        }

        function renderTablaRetornos() {
            const tbody = document.getElementById('tbody-retornos');
            if (retornosRecibidos.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="13" class="py-10 text-center text-slate-400">
