        function formatearFechaSAP(valorCrudo) {
            if (valorCrudo === null || valorCrudo === undefined || valorCrudo === '') {
                const hoy = new Date();
                return `${String(hoy.getDate()).padStart(2, '0')}.${String(hoy.getMonth() + 1).padStart(2, '0')}.${hoy.getFullYear()}`;
            }
            if (typeof valorCrudo === 'string') {
                const limpio = valorCrudo.trim();
                if (/^\d{2}\.\d{2}\.\d{4}$/.test(limpio)) return limpio;
                if (/^\d{2}\/\d{2}\/\d{4}$/.test(limpio)) return limpio.replace(/\//g, '.');
                if (/^\d{4}-\d{2}-\d{2}/.test(limpio)) {
                    const [y, m, d] = limpio.slice(0, 10).split('-');
                    return `${d}.${m}.${y}`;
                }
                if (!isNaN(Number(limpio)) && Number(limpio) > 20000) valorCrudo = Number(limpio);
                else return limpio;
            }
            if (typeof valorCrudo === 'number') {
                const parsed = XLSX.SSF.parse_date_code(valorCrudo);
                if (parsed) return `${String(parsed.d).padStart(2, '0')}.${String(parsed.m).padStart(2, '0')}.${parsed.y}`;
            }
            if (valorCrudo instanceof Date && !isNaN(valorCrudo)) {
                return `${String(valorCrudo.getDate()).padStart(2, '0')}.${String(valorCrudo.getMonth() + 1).padStart(2, '0')}.${valorCrudo.getFullYear()}`;
            }
            return String(valorCrudo);
        }

        function procesarArchivoExcel(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = async function(e) {
                try {
                    const data = new Uint8Array(e.target.result);
                    const workbook = XLSX.read(data, { type: 'array', cellDates: false });
                    const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
                    const matrix = XLSX.utils.sheet_to_json(firstSheet, { header: 1, defval: '' });

                    if (matrix.length <= 1) {
                        showToast('El archivo Excel está vacío.', 'error');
                        return;
                    }

                    const headers = matrix[0].map(h => String(h).trim().toLowerCase());
                    const dataRows = matrix.slice(1);
                    const esFormatoZMM0014 = headers[5] && headers[5].includes('entrega');

                    const nuevosRegistros = dataRows.map(row => {
                        if (!row || row.length === 0) return null;

                        if (esFormatoZMM0014) {
                            const entrega = String(row[5] || '').trim();
                            if (!entrega) return null;

                            const codOrigen = String(row[0] || '').trim();
                            const descOrigen = String(row[1] || '').trim();
                            const origenFull = codOrigen && descOrigen ? `${codOrigen} - ${descOrigen}` : (codOrigen || descOrigen || 'ORIGEN SAP');

                            return {
                                entrega,
                                material: String(row[11] || '').trim() || '1200000090',
                                descMaterial: String(row[12] || '').trim() || 'MATERIAL LOGÍSTICO',
                                origen: origenFull,
                                destino: String(row[2] || '').trim() || 'DESTINO SAP',
                                fechaContabilizacion: formatearFechaSAP(row[8]),
                                cartaPorte: String(row[18] || '').trim(),
                                unidad: String(row[19] || '').trim(),
                                cantidad: parseFloat(row[13]) || 0,
                                um: String(row[15] || '').trim() || 'PZA'
                            };
                        } else {
                            const getByPattern = (patterns) => {
                                const idx = headers.findIndex(h => patterns.some(p => h.includes(p)));
                                return idx >= 0 ? row[idx] : '';
                            };
                            const entrega = String(getByPattern(['entrega', 'delivery']) || '').trim();
                            if (!entrega) return null;

                            return {
                                entrega,
                                material: String(row[11] || getByPattern(['material', 'mat']) || '1200000090').trim(),
                                descMaterial: String(row[12] || getByPattern(['descripción', 'descripcion', 'texto']) || 'MATERIAL LOGÍSTICO').trim(),
                                origen: String(getByPattern(['origen', 'ce.']) || 'ORIGEN SAP').trim(),
                                destino: String(row[2] || getByPattern(['destino']) || 'DESTINO SAP').trim(),
                                fechaContabilizacion: formatearFechaSAP(getByPattern(['fecha', 'contab'])),
                                cartaPorte: String(row[18] !== undefined ? row[18] : getByPattern(['trailer', 'viaje'])).trim(),
                                unidad: String(row[19] !== undefined ? row[19] : getByPattern(['carta porte', 'unidad'])).trim(),
                                cantidad: parseFloat(row[13] !== undefined ? row[13] : getByPattern(['cantidad', 'ctd'])) || 0,
                                um: String(getByPattern(['um']) || 'PZA').trim()
                            };
                        }
                    }).filter(Boolean);

                    if (nuevosRegistros.length > 0) {
                        sapDatabase = nuevosRegistros;
                        await saveState();
                        poblarSelectorEntregas();
                        filtrarTablaModalSAP('');
                        showToast(`Se cargaron ${nuevosRegistros.length} filas desde ${file.name}.`, 'success');
                    } else {
                        showToast('No se detectaron entregas válidas en el Excel.', 'error');
                    }
                } catch (err) {
                    console.error(err);
                    showToast('Error al leer el archivo Excel.', 'error');
                }
            };
            reader.readAsArrayBuffer(file);
        }

        // =========================================================================
        // 8. INICIALIZACIÓN DE FIRMAS DIGITALES (Elaboró y Operador)
        // =========================================================================
        function inicializarCanvasFirmas() {
            // Canvas Elaboró
            canvasFirmaElaboro = document.getElementById('signature-pad-elaboro');
            if (canvasFirmaElaboro) {
                ctxFirmaElaboro = canvasFirmaElaboro.getContext('2d');
                const r = canvasFirmaElaboro.getBoundingClientRect();
                canvasFirmaElaboro.width = r.width || 300;
                canvasFirmaElaboro.height = r.height || 70;
                ctxFirmaElaboro.strokeStyle = '#0f172a';
                ctxFirmaElaboro.lineWidth = 2;
                ctxFirmaElaboro.lineCap = 'round';

                canvasFirmaElaboro.onmousedown = (e) => { dibujandoElaboro = true; ctxFirmaElaboro.beginPath(); ctxFirmaElaboro.moveTo(e.offsetX, e.offsetY); };
                canvasFirmaElaboro.onmousemove = (e) => { if (dibujandoElaboro) { ctxFirmaElaboro.lineTo(e.offsetX, e.offsetY); ctxFirmaElaboro.stroke(); } };
                canvasFirmaElaboro.onmouseup = () => dibujandoElaboro = false;
                canvasFirmaElaboro.onmouseleave = () => dibujandoElaboro = false;

                canvasFirmaElaboro.ontouchstart = (e) => {
                    const t = e.touches[0], rect = canvasFirmaElaboro.getBoundingClientRect();
                    dibujandoElaboro = true; ctxFirmaElaboro.beginPath(); ctxFirmaElaboro.moveTo(t.clientX - rect.left, t.clientY - rect.top);
                    e.preventDefault();
                };
                canvasFirmaElaboro.ontouchmove = (e) => {
                    if (!dibujandoElaboro) return;
                    const t = e.touches[0], rect = canvasFirmaElaboro.getBoundingClientRect();
                    ctxFirmaElaboro.lineTo(t.clientX - rect.left, t.clientY - rect.top); ctxFirmaElaboro.stroke();
                    e.preventDefault();
                };
                canvasFirmaElaboro.ontouchend = () => dibujandoElaboro = false;
            }

            // Canvas Operador
            canvasFirmaOperador = document.getElementById('signature-pad-operador');
            if (canvasFirmaOperador) {
                ctxFirmaOperador = canvasFirmaOperador.getContext('2d');
                const r = canvasFirmaOperador.getBoundingClientRect();
                canvasFirmaOperador.width = r.width || 300;
                canvasFirmaOperador.height = r.height || 70;
                ctxFirmaOperador.strokeStyle = '#0f172a';
                ctxFirmaOperador.lineWidth = 2;
                ctxFirmaOperador.lineCap = 'round';

                canvasFirmaOperador.onmousedown = (e) => { dibujandoOperador = true; ctxFirmaOperador.beginPath(); ctxFirmaOperador.moveTo(e.offsetX, e.offsetY); };
                canvasFirmaOperador.onmousemove = (e) => { if (dibujandoOperador) { ctxFirmaOperador.lineTo(e.offsetX, e.offsetY); ctxFirmaOperador.stroke(); } };
                canvasFirmaOperador.onmouseup = () => dibujandoOperador = false;
                canvasFirmaOperador.onmouseleave = () => dibujandoOperador = false;

                canvasFirmaOperador.ontouchstart = (e) => {
                    const t = e.touches[0], rect = canvasFirmaOperador.getBoundingClientRect();
                    dibujandoOperador = true; ctxFirmaOperador.beginPath(); ctxFirmaOperador.moveTo(t.clientX - rect.left, t.clientY - rect.top);
                    e.preventDefault();
                };
                canvasFirmaOperador.ontouchmove = (e) => {
                    if (!dibujandoOperador) return;
                    const t = e.touches[0], rect = canvasFirmaOperador.getBoundingClientRect();
                    ctxFirmaOperador.lineTo(t.clientX - rect.left, t.clientY - rect.top); ctxFirmaOperador.stroke();
                    e.preventDefault();
                };
                canvasFirmaOperador.ontouchend = () => dibujandoOperador = false;
            }
        }

        function limpiarFirma(tipo) {
            if (tipo === 'elaboro' && ctxFirmaElaboro && canvasFirmaElaboro) {
                ctxFirmaElaboro.clearRect(0, 0, canvasFirmaElaboro.width, canvasFirmaElaboro.height);
            } else if (tipo === 'operador' && ctxFirmaOperador && canvasFirmaOperador) {
                ctxFirmaOperador.clearRect(0, 0, canvasFirmaOperador.width, canvasFirmaOperador.height);
            }
        }

        // =========================================================================
        // 9. CARÁTULA DE RESUMEN Y EXPORTACIÓN
        // =========================================================================
        function abrirCaratulaResumen(consId) {
            const cons = consolidadosList.find(c => c.id === consId);
            if (!cons) return;

            caratulaActivaId = consId;
            const detalleFilas = retornosRecibidos.filter(r => r.consolidadoId === consId && esItemTarimaChep(r));

            document.getElementById('car-folio').textContent = cons.id;
            document.getElementById('car-fecha-emision').textContent = `Emitido: ${cons.fechaConsolidacion}`;
            document.getElementById('car-unidad').textContent = cons.unidadConsolidacion;
            document.getElementById('car-entrega-salida').textContent = cons.entregaSalida || 'PENDIENTE POR ASIGNAR';
            document.getElementById('car-operador').textContent = cons.operador || 'PENDIENTE POR ASIGNAR';
            document.getElementById('car-firma-operador').textContent = cons.operador ? `Operador: ${cons.operador}` : 'Operador de Transporte';
            document.getElementById('car-observaciones').textContent = cons.notas || '-';

            const estatusEl = document.getElementById('car-estatus');
            estatusEl.textContent = cons.estatus;
            estatusEl.className = cons.estatus === 'Enviado'
                ? 'inline-block text-xs font-extrabold px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 mt-0.5'
                : 'inline-block text-xs font-extrabold px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-800 mt-0.5';

            let sumTransito = 0;
            const tbody = document.getElementById('car-tbody-detalle');

            if (detalleFilas.length > 0) {
                tbody.innerHTML = detalleFilas.map(d => {
                    sumTransito += d.transito;
                    return `
                        <tr class="hover:bg-slate-50">
                            <td class="py-2.5 px-3 font-bold text-blue-900">${d.entrega}</td>
                            <td class="py-2.5 px-3 text-slate-700">${d.origen}</td>
                            <td class="py-2.5 px-3 font-bold text-blue-950">${d.unidad} <span class="text-xs font-normal text-slate-500">(${d.cartaPorte || 'Sin Viaje'})</span></td>
                            <td class="py-2.5 px-3">
                                <span class="font-bold text-slate-900">${d.material}</span> - <span class="text-slate-600">${d.descMaterial}</span>
                            </td>
                            <td class="py-2.5 px-3 text-center font-semibold">${d.transito}</td>
                        </tr>
                    `;
                }).join('');
            } else {
                sumTransito = cons.totalTarimas;
                tbody.innerHTML = cons.entregas.map(e => `
                    <tr>
                        <td class="py-2.5 px-3 font-bold text-blue-900">${e.entrega}</td>
                        <td class="py-2.5 px-3">${e.origen}</td>
                        <td class="py-2.5 px-3">-</td>
                        <td class="py-2.5 px-3">1200000090 - TARIMA CHEP</td>
                        <td class="py-2.5 px-3 text-center">${e.transito || e.buenas}</td>
                    </tr>
                `).join('');
            }

            document.getElementById('car-tfoot-totales').innerHTML = `
                <tr>
                    <td colspan="4" class="py-2.5 px-3 text-right uppercase text-[11px]">Total Tránsito SAP (${cons.entregas.length} entregas):</td>
                    <td class="py-2.5 px-3 text-center">${sumTransito}</td>
                </tr>
            `;

            document.getElementById('car-kpi-entregas').textContent = cons.entregas.length;
            document.getElementById('car-kpi-transito').textContent = sumTransito;
            document.getElementById('car-kpi-buenas').textContent = cons.totalTarimas;

            document.getElementById('modal-caratula').classList.remove('hidden');
            setTimeout(inicializarCanvasFirmas, 100);
            lucide.createIcons();
        }

        function closeCaratulaModal() {
            document.getElementById('modal-caratula').classList.add('hidden');
            caratulaActivaId = null;
        }

        function descargarCaratulaExcel() {
            if (!caratulaActivaId) return;
            const cons = consolidadosList.find(c => c.id === caratulaActivaId);
            if (!cons) return;

            const detalleFilas = retornosRecibidos.filter(r => r.consolidadoId === caratulaActivaId && esItemTarimaChep(r));
            const filasExport = detalleFilas.map(d => ({
                "Folio Consolidado": cons.id,
                "Unidad Consolidada": cons.unidadConsolidacion,
                "Entrega de Salida": cons.entregaSalida || "PENDIENTE",
                "Operador": cons.operador || "PENDIENTE",
                "Entrega Recibida": d.entrega,
                "Localidad Origen": d.origen,
                "Unidad Original (Col. T)": d.unidad,
                "Viaje / Carta Porte": d.cartaPorte,
                "Material": d.material,
                "Descripción": d.descMaterial,
                "Tránsito SAP": d.transito
            }));

            const ws = XLSX.utils.json_to_sheet(filasExport);
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, cons.id);
            XLSX.writeFile(wb, `Caratula_${cons.id}.xlsx`);
            showToast(`Carátula ${cons.id} exportada a Excel.`, 'success');
        }

        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            const colors = {
                success: 'bg-emerald-900 text-white border-emerald-700',
                error: 'bg-rose-900 text-white border-rose-700',
                warning: 'bg-amber-900 text-white border-amber-700',
                info: 'bg-slate-900 text-white border-slate-700'
            };
            toast.className = `${colors[type]} border px-4 py-3 rounded-xl shadow-xl text-xs font-semibold flex items-center justify-between gap-2 pointer-events-auto transition-all`;
            toast.innerHTML = `<span>${message}</span>`;
            container.appendChild(toast);
            setTimeout(() => { toast.style.opacity = '0'; setTimeout(() => toast.remove(), 300); }, 3500);
        }

        function openConfirmReset() { document.getElementById('modal-reset').classList.remove('hidden'); lucide.createIcons(); }
        function closeConfirmReset() { document.getElementById('modal-reset').classList.add('hidden'); }

        async function ejecutarReset() {
            try {
                sapDatabase = [...INITIAL_SAP_DATA];
                retornosRecibidos = [];
                consolidadosList = [];
                carritoConsolidado = [];
                await saveState();
                closeConfirmReset();
                limpiarFormularioRetorno();
                poblarSelectorEntregas();
                renderTablaRetornos();
                renderCarritoConsolidado();
                renderListaRetornosDisponibles();
                renderEnviosConsolidados();
                renderConfirmacion();
                showToast('Datos restaurados al estado original del reporte ZMM0014.XLSX.', 'info');
            } catch (error) {
                showToast('No fue posible reiniciar los datos en Dataverse.', 'error');
            }
        }

        window.addEventListener('DOMContentLoaded', initApp);
    </script>
