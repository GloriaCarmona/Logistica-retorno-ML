                    <td class="py-3 px-4 text-xs text-slate-600 whitespace-nowrap">${r.fechaRecibo}</td>
                    <td class="py-3 px-4 text-xs text-slate-600 max-w-[160px] truncate" title="${r.comentarios}">${r.comentarios}</td>
                    <td class="py-3 px-4 text-center">
                        ${r.consolidadoId 
                            ? `<span class="inline-block text-[11px] font-bold bg-indigo-100 text-indigo-800 px-2.5 py-0.5 rounded-full">Consolidado (${r.consolidadoId})</span>`
                            : `<span class="inline-block text-[11px] font-bold bg-emerald-100 text-emerald-800 px-2.5 py-0.5 rounded-full">Recibido</span>`
