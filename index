        function renderGraficas() {
            const totalTransitoSap = sapDatabase.reduce((acc, item) => acc + (Number(item.cantidad) || 0), 0);
            const totalEntregasSap = new Set(sapDatabase.map(i => i.entrega)).size;

            const totalBuenas = retornosRecibidos.reduce((acc, r) => acc + r.buenas, 0);
            const totalDanado = retornosRecibidos.reduce((acc, r) => acc + r.danado, 0);
            const totalScrap = retornosRecibidos.reduce((acc, r) => acc + r.scrap, 0);
            const totalFaltante = retornosRecibidos.reduce((acc, r) => acc + r.faltante, 0);
            const totalDefectos = totalDanado + totalScrap + totalFaltante;
            const entregasRecibidasUnicas = new Set(retornosRecibidos.map(r => r.entrega)).size;

            const porcentajeAvance = totalEntregasSap > 0 ? Math.round((entregasRecibidasUnicas / totalEntregasSap) * 100) : 0;

            document.getElementById('kpi-transito-tarimas').textContent = totalTransitoSap.toLocaleString();
            document.getElementById('kpi-transito-entregas').textContent = totalEntregasSap;
            document.getElementById('kpi-recibido-buenas').textContent = totalBuenas.toLocaleString();
            document.getElementById('kpi-recibido-entregas').textContent = entregasRecibidasUnicas;
            document.getElementById('kpi-defectos-total').textContent = totalDefectos.toLocaleString();
            document.getElementById('kpi-porcentaje-avance').textContent = `${porcentajeAvance}%`;

            const ctxComp = document.getElementById('chart-comparativo').getContext('2d');
            if (chartComparativo) chartComparativo.destroy();
            chartComparativo = new Chart(ctxComp, {
                type: 'bar',
                data: {
                    labels: ['Tránsito Total SAP', 'Recibido Buenas', 'Incidencias (Dañ/Scr/Fal)', 'Pendiente por Recibir'],
                    datasets: [{
                        label: 'Cantidad de Unidades / Tarimas',
                        data: [totalTransitoSap, totalBuenas, totalDefectos, Math.max(0, totalTransitoSap - (totalBuenas + totalDefectos))],
                        backgroundColor: ['#1e3a8a', '#10b981', '#f59e0b', '#94a3b8'],
                        borderRadius: 8
                    }]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
            });

            const ctxCal = document.getElementById('chart-calidad').getContext('2d');
            if (chartCalidad) chartCalidad.destroy();
            const hasRecibos = (totalBuenas + totalDefectos) > 0;
            chartCalidad = new Chart(ctxCal, {
                type: 'doughnut',
                data: {
                    labels: hasRecibos ? ['Buenas', 'Dañadas', 'Scrap', 'Faltante'] : ['Sin recibos registrados'],
                    datasets: [{
                        data: hasRecibos ? [totalBuenas, totalDanado, totalScrap, totalFaltante] : [1],
                        backgroundColor: hasRecibos ? ['#10b981', '#f59e0b', '#e11d48', '#64748b'] : ['#e2e8f0'],
                        borderWidth: 2
                    }]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
            });

            const origenesMap = {};
            sapDatabase.forEach(item => { if (!origenesMap[item.origen]) origenesMap[item.origen] = { danado: 0, scrap: 0, faltante: 0, buenas: 0 }; });
            retornosRecibidos.forEach(r => {
                if (!origenesMap[r.origen]) origenesMap[r.origen] = { danado: 0, scrap: 0, faltante: 0, buenas: 0 };
                origenesMap[r.origen].danado += r.danado;
                origenesMap[r.origen].scrap += r.scrap;
                origenesMap[r.origen].faltante += r.faltante;
                origenesMap[r.origen].buenas += r.buenas;
            });

            const labelsOrigen = Object.keys(origenesMap);
            const ctxOrig = document.getElementById('chart-origenes').getContext('2d');
            if (chartOrigenes) chartOrigenes.destroy();
            chartOrigenes = new Chart(ctxOrig, {
                type: 'bar',
                data: {
                    labels: labelsOrigen,
                    datasets: [
                        { label: 'Dañado', data: labelsOrigen.map(o => origenesMap[o].danado), backgroundColor: '#f59e0b', borderRadius: 4 },
                        { label: 'Scrap', data: labelsOrigen.map(o => origenesMap[o].scrap), backgroundColor: '#e11d48', borderRadius: 4 },
                        { label: 'Faltante', data: labelsOrigen.map(o => origenesMap[o].faltante), backgroundColor: '#64748b', borderRadius: 4 }
                    ]
                },
                options: { responsive: true, maintainAspectRatio: false, scales: { x: { stacked: true }, y: { stacked: true, beginAtZero: true, ticks: { stepSize: 1 } } } }
            });
        }

