        function poblarSelectorEntregas() {
            const select = document.getElementById('select-entrega-demo');
            const recibidasSet = new Set(retornosRecibidos.map(r => r.entrega));
            const entregasMap = new Map();

            sapDatabase.forEach(item => {
                if (!entregasMap.has(item.entrega)) {
                    entregasMap.set(item.entrega, { entrega: item.entrega, origen: item.origen, totalCantidad: 0, filas: 0 });
                }
                const entry = entregasMap.get(item.entrega);
                entry.totalCantidad += (Number(item.cantidad) || 0);
                entry.filas += 1;
            });

            select.innerHTML = '<option value="">-- Seleccionar entrega en tránsito --</option>';
            entregasMap.forEach(info => {
                const yaRecibida = recibidasSet.has(info.entrega);
                const opt = document.createElement('option');
                opt.value = info.entrega;
                const etiquetaFilas = info.filas > 1 ? ` [${info.filas} materiales]` : '';
                opt.textContent = `${info.entrega} | ${info.origen} (${info.totalCantidad} pzas${etiquetaFilas})${yaRecibida ? ' [YA RECIBIDA]' : ''}`;
                if (yaRecibida) opt.disabled = true;
                select.appendChild(opt);
            });
        }

        function seleccionarEntregaCombo(val) {
