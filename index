        // =========================================================================
        // 4. MÓDULO 2: CONSOLIDADOS Y ENVÍOS CONSOLIDADOS
        // =========================================================================
        function esItemTarimaChep(r) {
            const mat = String(r.material || '').trim();
            const desc = String(r.descMaterial || '').trim().toUpperCase();
            return mat === '1200000090' || desc.includes('TARIMA CHEP');
        }

        function renderListaRetornosDisponibles() {
            const container = document.getElementById('lista-retornos-disponibles');
            const carritoSet = new Set(carritoConsolidado.map(c => c.entrega));
            const disponiblesMap = new Map();

            retornosRecibidos.forEach(r => {
                if (!r.consolidadoId && !carritoSet.has(r.entrega) && esItemTarimaChep(r)) {
                    if (!disponiblesMap.has(r.entrega)) {
                        disponiblesMap.set(r.entrega, { entrega: r.entrega, origen: r.origen, buenas: 0 });
                    }
                    disponiblesMap.get(r.entrega).buenas += r.buenas;
                }
            });

            if (disponiblesMap.size === 0) {
                container.innerHTML = `<span class="text-xs text-slate-400">No hay entregas recibidas con el ítem 1200000090-TARIMA CHEP pendientes por consolidar.</span>`;
                return;
            }

            container.innerHTML = Array.from(disponiblesMap.values()).map(info => `
                <button onclick="agregarEntregaPorNumero('${info.entrega}')" 
                    class="inline-flex items-center gap-1.5 bg-white hover:bg-blue-50 border border-slate-300 hover:border-blue-400 text-slate-700 px-3 py-1.5 rounded-lg text-xs font-semibold transition cursor-pointer shadow-2xs">
                    <span class="font-bold text-blue-800">${info.entrega}</span>
                    <span class="text-slate-400">|</span>
                    <span class="text-emerald-700 font-bold">${info.buenas} buenas</span>
                    <i data-lucide="plus" class="w-3.5 h-3.5 text-blue-600"></i>
                </button>
            `).join('');
            lucide.createIcons();
        }

        function agregarEntregaAConsolidado() {
            const input = document.getElementById('input-entrega-consolidar');
            const val = input.value.trim();
            if (!val) return;
            agregarEntregaPorNumero(val);
            input.value = '';
        }

        function agregarEntregaPorNumero(numEntrega) {
            const todasFilasEntrega = retornosRecibidos.filter(r => r.entrega === numEntrega);
            if (todasFilasEntrega.length === 0) {
                showToast(`La entrega ${numEntrega} aún no ha sido recibida en el módulo Retorno.`, 'error');
                return;
            }
            const filasRetorno = todasFilasEntrega.filter(r => esItemTarimaChep(r));
            if (filasRetorno.length === 0) {
                showToast(`La entrega ${numEntrega} no contiene registros del ítem 1200000090-TARIMA CHEP.`, 'error');
                return;
            }
            if (filasRetorno.some(r => r.consolidadoId)) {
                showToast(`La entrega ${numEntrega} ya pertenece al consolidado ${filasRetorno[0].consolidadoId}.`, 'error');
                return;
            }
            if (carritoConsolidado.some(c => c.entrega === numEntrega)) {
                showToast(`La entrega ${numEntrega} ya está agregada en la lista.`, 'warning');
                return;
            }

            const totalBuenas = filasRetorno.reduce((acc, r) => acc + r.buenas, 0);
            const totalTransito = filasRetorno.reduce((acc, r) => acc + r.transito, 0);

            carritoConsolidado.push({
                entrega: numEntrega,
                origen: filasRetorno[0].origen,
                buenas: totalBuenas,
                transito: totalTransito,
                lineasCount: filasRetorno.length
            });

            renderCarritoConsolidado();
            renderListaRetornosDisponibles();
        }

        function quitarDelCarritoConsolidado(numEntrega) {
            carritoConsolidado = carritoConsolidado.filter(c => c.entrega !== numEntrega);
            renderCarritoConsolidado();
            renderListaRetornosDisponibles();
        }

        function renderCarritoConsolidado() {
            const tbody = document.getElementById('tbody-carrito-consolidado');
            const totalEntregasEl = document.getElementById('cons-total-entregas');
            const totalTarimasEl = document.getElementById('cons-total-tarimas');

            if (carritoConsolidado.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="py-6 text-center text-slate-400 text-xs">Aún no has agregado entregas a este consolidado.</td></tr>`;
                totalEntregasEl.textContent = '0';
                totalTarimasEl.textContent = '0';
                return;
            }

            let sumTarimas = 0;
            tbody.innerHTML = carritoConsolidado.map(item => {
                sumTarimas += item.buenas;
                return `
                    <tr>
                        <td class="py-2.5 px-3 font-bold text-blue-900">${item.entrega}</td>
                        <td class="py-2.5 px-3 text-xs text-slate-600">${item.origen}</td>
                        <td class="py-2.5 px-3 text-center font-bold text-emerald-700">${item.buenas}</td>
                        <td class="py-2.5 px-3 text-center text-xs text-slate-500">${item.transito}</td>
                        <td class="py-2.5 px-3 text-right">
                            <button onclick="quitarDelCarritoConsolidado('${item.entrega}')" class="text-rose-500 hover:text-rose-700 cursor-pointer">
                                <i data-lucide="trash-2" class="w-4 h-4 inline"></i>
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');

            totalEntregasEl.textContent = carritoConsolidado.length;
            totalTarimasEl.textContent = sumTarimas;
            lucide.createIcons();
        }

        async function generarConsolidado() {
            if (carritoConsolidado.length === 0) {
                showToast('Agrega al menos una entrega recibida para consolidar.', 'error');
                return;
            }
            const unidad = document.getElementById('input-unidad-consolidado').value.trim();
            if (!unidad) {
                showToast('Ingresa manualmente la Unidad en la que se consolida.', 'error');
                document.getElementById('input-unidad-consolidado').focus();
                return;
            }

            const notas = document.getElementById('input-notas-consolidado').value.trim();
            const consId = `CONS-${String(consolidadosList.length + 1).padStart(3, '0')}`;
            const totalTarimas = carritoConsolidado.reduce((acc, item) => acc + item.buenas, 0);
            const fechaAhora = new Date().toLocaleDateString('es-MX', { day: '2-digit', month: '2-digit', year: 'numeric' }) + ' ' +
                               new Date().toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });

            const nuevoConsolidado = {
                id: consId,
                entregas: carritoConsolidado.map(c => ({
                    entrega: c.entrega,
                    origen: c.origen,
                    buenas: c.buenas,
                    transito: c.transito
                })),
                totalTarimas,
                unidadConsolidacion: unidad,
                notas: notas || '-',
                fechaConsolidacion: fechaAhora,
                entregaSalida: '',
                operador: '',
                estatus: 'Pendiente de Envío',
                cantidadRecibidaConfirmada: totalTarimas,
                documentoSapCompra: ''
            };

            const setIds = new Set(carritoConsolidado.map(c => c.entrega));
            retornosRecibidos.forEach(r => {
                if (setIds.has(r.entrega) && esItemTarimaChep(r)) {
                    r.consolidadoId = consId;
                }
            });

            consolidadosList.unshift(nuevoConsolidado);
            carritoConsolidado = [];
            document.getElementById('input-unidad-consolidado').value = '';
            document.getElementById('input-notas-consolidado').value = '';

            await saveState();
            renderCarritoConsolidado();
            renderListaRetornosDisponibles();
            renderTablaRetornos();
            renderEnviosConsolidados();
            renderConfirmacion();

            showToast(`Consolidado ${consId} generado con éxito.`, 'success');
            switchSubConsolidado('envios');
        }

