        const PP_CONFIG = {
            entitySetName: "REEMPLAZAR_ENTITY_SET_NAME",
            primaryIdField: "REEMPLAZAR_PRIMARY_ID_FIELD",
            nameField: "REEMPLAZAR_NAME_FIELD",
            nameValue: "CONTROL_TRANSITOS_SAP",
            sapField: "REEMPLAZAR_SAP_JSON_FIELD",
