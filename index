                    (cons.entregaSalida && cons.entregaSalida.toLowerCase().includes(queryCaja));

                let matchFecha = true;
                if (fechaFiltroVal) {
                    const partesFecha = cons.fechaConsolidacion.split(' ')[0].split('/');
