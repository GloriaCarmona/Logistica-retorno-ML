        function buscarEntregaSAP(valor) {
            const query = valor.trim();
            const panel = document.getElementById('panel-detalle-entrega');
            const statusMsg = document.getElementById('entrega-status-msg');

            if (!query) {
                entregaSeleccionadaActual = null;
                panel.classList.add('opacity-50', 'pointer-events-none');
                document.getElementById('tbody-materiales-entrega').innerHTML = '';
                document.getElementById('sap-carta-porte').value = '';
                document.getElementById('sap-unidad').value = '';
                statusMsg.innerHTML = 'Escribe o selecciona un número de entrega para cargar automáticamente todas sus líneas de SAP.';
                statusMsg.className = 'mt-2 text-xs font-medium text-slate-500';
                return;
            }

            const yaRecibida = retornosRecibidos.find(r => r.entrega === query);
            if (yaRecibida) {
                entregaSeleccionadaActual = null;
                panel.classList.add('opacity-50', 'pointer-events-none');
                statusMsg.innerHTML = `<span class="text-amber-700 font-bold">⚠️ La entrega ${query} ya fue registrada como recibida el ${yaRecibida.fechaRecibo}.</span>`;
                return;
            }

            const filasEntrega = sapDatabase.filter(item => item.entrega === query);
            if (filasEntrega.length > 0) {
                const cabecera = filasEntrega[0];
                entregaSeleccionadaActual = {
                    entrega: cabecera.entrega,
                    origen: cabecera.origen,
                    destino: cabecera.destino,
                    fechaContabilizacion: cabecera.fechaContabilizacion,
                    cartaPorte: cabecera.cartaPorte || '',
                    unidad: cabecera.unidad || '',
                    lineas: filasEntrega.map((f, idx) => ({
                        rowId: `sap_${idx}_${Date.now()}`,
                        material: f.material,
                        descMaterial: f.descMaterial,
                        um: f.um || 'PZA',
                        transito: Number(f.cantidad) || 0,
                        danado: 0,
                        scrap: 0,
                        faltante: 0,
                        esExtra: false
                    }))
                };

                const totalPiezas = entregaSeleccionadaActual.lineas.reduce((acc, l) => acc + l.transito, 0);
                panel.classList.remove('opacity-50', 'pointer-events-none');
                statusMsg.innerHTML = `<span class="text-emerald-700 font-bold">✓ Entrega ${cabecera.entrega} encontrada en SAP (${filasEntrega.length} línea(s) / ${totalPiezas} unidades en tránsito).</span>`;

                document.getElementById('badge-filas-entrega').textContent = `${filasEntrega.length} línea(s) en entrega`;
                document.getElementById('sap-origen').textContent = cabecera.origen;
                document.getElementById('sap-destino').textContent = cabecera.destino;
                document.getElementById('sap-carta-porte').value = cabecera.cartaPorte || '';
                document.getElementById('sap-unidad').value = cabecera.unidad || '';
                document.getElementById('input-comentarios').value = '';

                renderTablaMaterialesEntrega();
                recalcularTarimas();
            } else {
                entregaSeleccionadaActual = null;
                panel.classList.add('opacity-50', 'pointer-events-none');
                document.getElementById('tbody-materiales-entrega').innerHTML = '';
                document.getElementById('sap-carta-porte').value = '';
                document.getElementById('sap-unidad').value = '';
                statusMsg.innerHTML = `<span class="text-rose-600 font-semibold">No se encontró la entrega "${query}" en la base de tránsitos SAP.</span>`;
            }
        }

