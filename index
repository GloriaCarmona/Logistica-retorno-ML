                    <td class="py-3 px-4 text-xs">
                        <span class="font-bold text-slate-800 block">${r.material}</span>
                        <span class="text-slate-500 text-[11px]">${r.descMaterial}</span>
                    </td>
                    <td class="py-3 px-4 text-xs font-medium text-slate-700">${r.origen}</td>
                    <td class="py-3 px-4 text-xs font-bold text-slate-800">${r.cartaPorte}</td>
