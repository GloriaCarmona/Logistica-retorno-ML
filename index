        function ppGetToken() {
            return new Promise((resolve, reject) => {
                if (!window.shell || typeof shell.getTokenDeferred !== 'function') {
                    reject(new Error('No se encontró el mecanismo de seguridad de Power Pages.'));
                    return;
                }
                shell.getTokenDeferred().done(resolve).fail(reject);
            });
        }

        async function ppRequest(method, path, body) {
            const token = await ppGetToken();
            const headers = {
                "Accept": "application/json",
                "Content-Type": "application/json; charset=utf-8",
                "OData-MaxVersion": "4.0",
                "OData-Version": "4.0",
                "__RequestVerificationToken": token
            };
            if (method === 'PATCH' || method === 'DELETE') headers['If-Match'] = '*';
            const response = await fetch('/_api/' + path, {
                method,
                headers,
                credentials: 'same-origin',
                body: body ? JSON.stringify(body) : undefined
            });
            if (!response.ok) {
                const detail = await response.text();
                throw new Error(`Dataverse ${method} ${response.status}: ${detail}`);
            }
            if (response.status === 204) return null;
            const type = response.headers.get('content-type') || '';
            return type.includes('application/json') ? response.json() : null;
        }

        function ppRecordQuery() {
            const select = [PP_CONFIG.primaryIdField, PP_CONFIG.nameField, PP_CONFIG.sapField,
                PP_CONFIG.returnsField, PP_CONFIG.consolidatedField].join(',');
            const filter = `${PP_CONFIG.nameField} eq '${PP_CONFIG.nameValue.replace(/'/g, "''")}'`;
            return `${PP_CONFIG.entitySetName}?$select=${select}&$filter=${encodeURIComponent(filter)}&$top=1`;
        }

        async function ppFindStateRecord() {
            const data = await ppRequest('GET', ppRecordQuery());
            return (data && data.value && data.value.length) ? data.value[0] : null;
        }

        async function ppEnsureStateRecord() {
            let record = await ppFindStateRecord();
            if (!record) {
                const initial = {
                    [PP_CONFIG.nameField]: PP_CONFIG.nameValue,
                    [PP_CONFIG.sapField]: JSON.stringify(INITIAL_SAP_DATA),
                    [PP_CONFIG.returnsField]: JSON.stringify([]),
                    [PP_CONFIG.consolidatedField]: JSON.stringify([])
                };
                await ppRequest('POST', PP_CONFIG.entitySetName, initial);
                record = await ppFindStateRecord();
            }
            if (!record || !record[PP_CONFIG.primaryIdField]) {
                throw new Error('No se pudo localizar el registro central de Control de Tránsitos en Dataverse.');
            }
            ppStateRecordId = record[PP_CONFIG.primaryIdField];
            return record;
        }

        async function ppLoadState() {
            const record = await ppEnsureStateRecord();
            return {
                sap: JSON.parse(record[PP_CONFIG.sapField] || '[]'),
                returns: JSON.parse(record[PP_CONFIG.returnsField] || '[]'),
                consolidated: JSON.parse(record[PP_CONFIG.consolidatedField] || '[]')
            };
        }

        async function ppSaveState() {
            if (!ppStateRecordId) await ppEnsureStateRecord();
            const payload = {
                [PP_CONFIG.sapField]: JSON.stringify(sapDatabase),
                [PP_CONFIG.returnsField]: JSON.stringify(retornosRecibidos),
                [PP_CONFIG.consolidatedField]: JSON.stringify(consolidadosList)
            };
            await ppRequest('PATCH', `${PP_CONFIG.entitySetName}(${ppStateRecordId})`, payload);
        }

        async function initApp() {
            try {
                const state = await ppLoadState();
                sapDatabase = state.sap.length ? state.sap : [...INITIAL_SAP_DATA];
                retornosRecibidos = state.returns;
                consolidadosList = state.consolidated;
            } catch (error) {
                console.error(error);
                showToast('No fue posible cargar los datos desde Dataverse. Revisa configuración y permisos.', 'error');
                return;
            }

            actualizarReloj();
            if (!ppClockStarted) {
                setInterval(actualizarReloj, 1000);
                ppClockStarted = true;
            }

            actualizarContadoresUI();
            poblarSelectorEntregas();
            renderTablaRetornos();
            renderListaRetornosDisponibles();
            renderEnviosConsolidados();
            renderConfirmacion();
            lucide.createIcons();
